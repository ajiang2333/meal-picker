DATABASE_URL="file:./dev.db"
PORT=8787
# Optional. Set this to your public API origin when using a domain/reverse proxy.
PUBLIC_BASE_URL=""

# Tencent Cloud GeneralAccurateOCR. Keep real secrets only in the server .env file.
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
TENCENT_OCR_REGION="ap-guangzhou"
# Hard safety cap. Must be an integer from 1 to 950.
OCR_MONTHLY_CALL_LIMIT=950
